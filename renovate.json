{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "helpers:pinGitHubActionDigests"],
  "timezone": "Europe/Berlin",
  "schedule": ["* * * * 6"],
  "minimumReleaseAge": "7 days",
  "minimumReleaseAgeBehaviour": "timestamp-optional",
  "rebaseWhen": "behind-base-branch",
  "rangeStrategy": "pin",
  "lockFileMaintenance": { "enabled": false },
  "packageRules": [
    {
      "description": "pnpm is pinned in package.json and mise.toml: update both together",
      "matchPackageNames": ["pnpm"],
      "groupName": "pnpm"
    },
    {
      "description": "Kubb CLI and plugins share one release train and must match",
      "matchPackageNames": ["kubb", "@kubb/**"],
      "groupName": "kubb"
    },
    {
      "description": "One weekly PR with all non-major updates, auto-merged after green CI (lint, typecheck, contract tests, build)",
      "matchPackageNames": ["*"],
      "matchUpdateTypes": ["minor", "patch", "digest"],
      "groupName": "all non-major dependencies",
      "automerge": true,
      "automergeType": "pr",
      "platformAutomerge": false
    }
  ]
}
